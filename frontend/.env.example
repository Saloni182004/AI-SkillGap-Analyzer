# Optional: absolute URL to your API gateway (e.g. https://api.example.com).
# Leave empty in development to use same-origin requests + Vite proxy → http://localhost:5000
VITE_API_BASE_URL=

# Optional: override gateway target for Vite dev proxy (defaults to http://localhost:5000)
# VITE_DEV_PROXY_TARGET=http://localhost:5000
